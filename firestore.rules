rules_version = '2';
// এই সাইট Cloud Firestore ব্যবহার করে না (তথ্য Realtime Database-এ থাকে), তাই Firestore পুরোপুরি বন্ধ রাখা হলো।
// ভবিষ্যতে Firestore চালু করলে শুধু লগইন করা ব্যবহারকারী পড়তে পারবেন, লেখার অনুমতি প্রধান শিক্ষকের ইমেইলে সীমাবদ্ধ।
service cloud.firestore {
  match /databases/{database}/documents {
    match /schools/kalyani-gps/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email in ['kalyani.gps@gmail.com'];
    }
    match /{document=**} { allow read, write: if false; }
  }
}
