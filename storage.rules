rules_version = '2';
// ছবি ও PDF: লগইন করা সবাই দেখতে পারবেন; শুধু অ্যাডমিন (নিচের ইমেইল) আপলোড/মুছতে পারবেন, সর্বোচ্চ ২০ MB।
service firebase.storage {
  match /b/{bucket}/o {
    match /schools/kalyani-gps/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email in ['kalyani.gps@gmail.com']   // আরও অ্যাডমিন থাকলে এখানে যোগ করুন
                   && (request.method == 'delete' || request.resource.size < 20 * 1024 * 1024);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
